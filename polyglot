def add_common_flags(p, link=False):
    p.add_argument("--std", metavar="STD",
                   help="language standard (c89..c2x / gnu*, c++98..c++23)")
    p.add_argument("--warn", choices=["none", "default", "all", "extra",
                                      "pedantic"], default="default",
                   help="warning level (default: default)")
    p.add_argument("--werror", action="store_true", help="warnings as errors")
    p.add_argument("--debug", action="store_true", help="emit debug info (-g)")
    p.add_argument("--sanitize", metavar="LIST",
                   help="sanitizers: %s" % ",".join(SANITIZERS))
    p.add_argument("-I", dest="includes", action="append", default=[],
                   metavar="DIR", help="include search path (repeatable)")
    p.add_argument("-D", dest="defines", action="append", default=[],
                   metavar="NAME[=VAL]", help="preprocessor define (repeatable)")
    p.add_argument("--cc-arg", dest="cc_args", action="append", default=[],
                   metavar="ARG", help="raw flag passed to the compiler (repeatable)")
    if link:
        p.add_argument("-L", dest="lib_dirs", action="append", default=[],
                       metavar="DIR", help="library search path (repeatable)")
        p.add_argument("-l", dest="libs", action="append", default=[],
                       metavar="NAME", help="link library (repeatable)")


def build_parser():
    parser = argparse.ArgumentParser(
        prog="polyglot", description="Universal Compiler Driver (v%s)" % VERSION,
        epilog="run 'polyglot <command> --help' for per-command options")
    parser.add_argument("--version", action="version",
                        version="polyglot %s" % VERSION,
                        help="show the version and exit")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="verbose output (full command lines, cache HIT/MISS)")
    parser.add_argument("--quiet", action="store_true",
                        help="suppress 'Running:' lines")
    parser.add_argument("--target", help="target triple (clang cross or host on gcc)")
    parser.add_argument("--opt-level",
                        choices=list(OPT_MAP), default="default",
                        help="optimization level (default: default)")
    parser.add_argument("-o", "--output", help="output file")
    parser.add_argument("--plugin", help="JSON-RPC plugin binary (name or "
                        "path; used by 'build')")
    parser.add_argument("--plugin-dir", default="~/.polyglot/plugins",
                        help="plugin search directory (default: ~/.polyglot/plugins)")
    parser.add_argument("--compiler", choices=["auto", "clang", "gcc"],
                        default="auto",
                        help="force a backend (default: auto-discover; "
                             "env POLYGLOT_CC/POLYGLOT_CXX override)")

    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("build", help="Build a source file or project")
    p.add_argument("paths", nargs="*", help="source files or project directory")
    p.add_argument("-o", "--output", default=argparse.SUPPRESS, help="output file")
    add_common_flags(p, link=True)
    p.add_argument("--shared", action="store_true", help="build a shared library")
    p.add_argument("--static-lib", action="store_true",
                   help="build a static library (ar rcs)")
    p.add_argument("-j", "--jobs", type=int, default=1,
                   help="parallel per-TU compilation")
    p.add_argument("--no-cache", action="store_true",
                   help="bypass the incremental object cache")

    p = sub.add_parser("run",
                       help="Build and run a source file (extra args after --)")
    p.add_argument("file", help="source file to run")
    add_common_flags(p, link=True)
    p.add_argument("-j", "--jobs", type=int, default=1,
                   help="parallel per-TU compilation")
    p.add_argument("--no-cache", action="store_true",
                   help="bypass the incremental object cache")
    p.set_defaults(_pass_through=True)   # program args arrive via extras

    p = sub.add_parser("check", help="Check syntax without building")
    p.add_argument("paths", nargs="+", help="source files to check")
    add_common_flags(p)

    p = sub.add_parser("emit-ir", help="Emit LLVM IR (clang) or GIMPLE (gcc)")
    p.add_argument("paths", nargs="+", help="source files")
    p.add_argument("-o", "--output", default=argparse.SUPPRESS, help="output file")
    add_common_flags(p)

    p = sub.add_parser("emit-asm", help="Emit assembly")
    p.add_argument("paths", nargs="+", help="source files")
    p.add_argument("-o", "--output", default=argparse.SUPPRESS, help="output file")
    p.add_argument("--intel", action="store_true", help="Intel syntax (-masm=intel)")
    add_common_flags(p)

    p = sub.add_parser("preproc", help="Run the preprocessor (-E)")
    p.add_argument("file", help="source file")
    p.add_argument("-o", "--output", default=argparse.SUPPRESS,
                   help="write output to file instead of stdout")
    p.add_argument("--no-lines", action="store_true",
                   help="strip line markers (-P)")
    add_common_flags(p)

    p = sub.add_parser("deps", help="Emit Make-style dependencies (-MM)")
    p.add_argument("file", help="source file")
    p.add_argument("-o", "--output", default=argparse.SUPPRESS,
                   help="write depfile here instead of stdout")
    p.add_argument("--target-name", metavar="NAME", help="rename the target (-MT)")
    add_common_flags(p)

    p = sub.add_parser("doctor", help="Report on the toolchain environment")
    p.add_argument("--strict", action="store_true",
                   help="exit 1 when anything is missing")

    sub.add_parser("targets", help="List known target triples and availability")

    p = sub.add_parser("fmt", help="Format code with clang-format")
    p.add_argument("paths", nargs="+", help="files to format")
    p.add_argument("--style", default="llvm",
                   choices=["llvm", "google", "chromium", "mozilla", "webkit",
                            "microsoft", "file"], help="clang-format style")
    p.add_argument("--check", action="store_true",
                   help="exit 1 if any file would change")
    p.add_argument("-i", dest="in_place", action="store_true",
                   help="format files in place")
    p.add_argument("--dump-config", action="store_true",
                   help="print the style config and exit")

    p = sub.add_parser("tidy", help="Lint with clang-tidy (extra args after --)")
    p.add_argument("paths", nargs="*", help="files to lint")
    p.add_argument("--checks", help="checks string, e.g. '-*,modernize-*'")
    p.add_argument("--fix", action="store_true", help="apply suggested fixes")
    p.set_defaults(extra=[])

    p = sub.add_parser("repl", help="Interactive clang-repl (args after --)")
    p.set_defaults(extra=[])

    p = sub.add_parser("jit", help="Run a .ll/.bc with lli (args after --)")
    p.add_argument("file", help="LLVM IR (.ll) or bitcode (.bc) file")
    p.set_defaults(extra=[])

    p = sub.add_parser("mca", help="Analyze machine code with llvm-mca")
    p.add_argument("file", help=".c source or .s assembly")
    p.add_argument("--iterations", type=int, default=3,
                   help="analysis iterations (default: 3)")
    p.add_argument("--mcpu", help="target CPU for the analysis")
    add_common_flags(p)

    p = sub.add_parser("analyze", help="clang static analyzer (--analyze)")
    p.add_argument("paths", nargs="+", help="source files")

    p = sub.add_parser("watch", help="Rebuild on file changes")
    p.add_argument("file", help="source file to watch")
    p.add_argument("--timeout", type=int, default=0,
                   help="exit after N seconds (0 = watch forever)")
    add_common_flags(p)

    p = sub.add_parser("stats", help="Compilation statistics")
    p.add_argument("paths", nargs="+", help="source files")
    p.add_argument("--target", default=argparse.SUPPRESS, help="target triple")
    p.add_argument("--opt-level", choices=list(OPT_MAP),
                   default=argparse.SUPPRESS, help="optimization level")
    p.add_argument("--json", action="store_true",
                   help="machine-readable JSON output")
    add_common_flags(p)

    p = sub.add_parser("init", help="Initialize a new project")
    p.add_argument("name", nargs="?", help="project name")
    p.add_argument("--language", choices=["c", "cpp", "rust"],
                   help="project language")

    p = sub.add_parser("clean", help="Remove build artifacts and cache")
    p.add_argument("path", nargs="?", default=".", help="project directory")

    sub.add_parser("version", help="Show version and backend")

    # Global-style flags also work after the subcommand (SUPPRESS defaults
    # keep the global values intact; guards avoid redefining existing ones).
    def _ensure(sub_p, *opts, **kw):
        have = {o for a in sub_p._actions for o in getattr(a, "option_strings", [])}
        if not any(o in have for o in opts):
            sub_p.add_argument(*opts, **kw)

    for sub_p in sub.choices.values():
        _ensure(sub_p, "-v", "--verbose", action="store_true",
                default=argparse.SUPPRESS, help=argparse.SUPPRESS)
        _ensure(sub_p, "--quiet", action="store_true",
                default=argparse.SUPPRESS, help=argparse.SUPPRESS)
        _ensure(sub_p, "--compiler", choices=["auto", "clang", "gcc"],
                default=argparse.SUPPRESS, help=argparse.SUPPRESS)
        _ensure(sub_p, "--target", default=argparse.SUPPRESS,
                help=argparse.SUPPRESS)
        _ensure(sub_p, "--opt-level", choices=list(OPT_MAP),
                default=argparse.SUPPRESS, help=argparse.SUPPRESS)
        _ensure(sub_p, "--plugin", default=argparse.SUPPRESS,
                help=argparse.SUPPRESS)
        _ensure(sub_p, "--plugin-dir", default=argparse.SUPPRESS,
                help=argparse.SUPPRESS)

    return parser


# program-argument pass-through commands: tokens after the first '--' belong
# to the child program / tool, not to polyglot.
PASS_THROUGH_CMDS = {"run", "tidy", "repl", "jit"}


def _find_subcommand(argv):
    """Index of the first token naming a known subcommand.

    Matching against the known command names (instead of heuristically
    skipping flags) keeps value-taking flags like `-I dir` or `--cc-arg x`
    from being mistaken for the subcommand when they appear before it.
    """
    for i, tok in enumerate(argv):
        if tok in HANDLERS:
            return i
    return None


def _split_at_ddash(tokens):
    if "--" in tokens:
        i = tokens.index("--")
        return tokens[:i], tokens[i + 1:]
    return tokens, None


HANDLERS = {
    "build": cmd_build, "run": cmd_run, "check": cmd_check,
    "emit-ir": cmd_emit_ir, "emit-asm": cmd_emit_asm, "preproc": cmd_preproc,
    "deps": cmd_deps, "doctor": cmd_doctor, "targets": cmd_targets,
    "fmt": cmd_fmt, "tidy": cmd_tidy, "repl": cmd_repl, "jit": cmd_jit,
    "mca": cmd_mca, "analyze": cmd_analyze, "watch": cmd_watch,
    "stats": cmd_stats, "init": cmd_init, "clean": cmd_clean,
    "version": cmd_version,
}


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    extra_program_args = None
    idx = _find_subcommand(argv)
    if idx is not None and idx > 0:
        # common flags typed before the subcommand are re-ordered after it so
        # the subparser (which mirrors the global flags) actually sees them;
        # otherwise parse_known_args drops them silently.
        argv = [argv[idx]] + argv[:idx] + argv[idx + 1:]
        idx = 0
    if idx is not None and argv[idx] in PASS_THROUGH_CMDS:
        head, tail = _split_at_ddash(argv)
        argv = head
        extra_program_args = tail

    parser = build_parser()
    args, unknown = parser.parse_known_args(argv)

    if args.command in PASS_THROUGH_CMDS:
        if extra_program_args is not None:
            passthrough = extra_program_args
        else:
            passthrough = [u for u in unknown if u != "--"]
            unknown = []
        if args.command == "run":
            args.args = passthrough
        else:
            args.extra = passthrough

    if unknown:
        err_print("error: unrecognized arguments: %s" % quote(unknown))
        sys.exit(EXIT_USAGE)

    try:
        if args.command == "clean":
            cmd_clean(None, args)
        else:
            tc = Toolchain(prefer=args.compiler,
                           defer=(args.command == "build"),
                           require=args.command not in ("doctor", "version"))
            HANDLERS[args.command](tc, args)
    except PolyglotError as exc:
        err_print("error: %s" % exc)
        sys.exit(exc.exit_code)
    except KeyboardInterrupt:
        print("\nInterrupted.")
        sys.exit(130)
    except SystemExit:
        raise
    except Exception as exc:  # never show a traceback to end users
        err_print("unexpected error: %r" % exc)
        if getattr(args, "verbose", False):
            import traceback
            traceback.print_exc(file=sys.stderr)
        sys.exit(EXIT_FAILURE)


if __name__ == "__main__":
    main()
