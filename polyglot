# --------------------------------------------------------------------------
# Small helpers: colored output, errors, shell quoting
# --------------------------------------------------------------------------

def _color_enabled():
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _paint(text, code, stream=sys.stdout):
    if getattr(stream, "isatty", lambda: False)() and not os.environ.get("NO_COLOR"):
        return "\033[%dm%s\033[0m" % (int(code), text)
    return str(text)


def green(text, stream=sys.stdout):
    return _paint(text, "32", stream)


def red(text, stream=sys.stdout):
    return _paint(text, "31", stream)


def yellow(text, stream=sys.stdout):
    return _paint(text, "33", stream)


def err_print(msg):
    print(red(msg, sys.stderr), file=sys.stderr)


class PolyglotError(Exception):
    """A friendly, user-facing error.  .exit_code decides the process exit."""

    def __init__(self, message, exit_code=EXIT_FAILURE):
        super().__init__(message)
        self.exit_code = exit_code


class MissingToolError(PolyglotError):
    """A backing tool could not be located."""

    def __init__(self, tool, searched=None, purpose=None):
        # main()'s handler already prefixes "error: " when printing.
        msg = "required tool '%s' not found" % tool
        if purpose:
            msg += " (needed for %s)" % purpose
        if searched:
            msg += "\nSearched: %s" % searched
        msg += "\nInstall it and re-run, or adjust PATH/POLYGLOT_CC."
        super().__init__(msg, EXIT_MISSING_TOOL)
        self.tool = tool


def quote(cmd):
    """Pretty-print a command list for logs (never used for execution)."""
    return " ".join(shlex.quote(str(c)) for c in cmd)


def run_cmd(cmd, **kwargs):
    """subprocess.run with list args only (never shell=True)."""
    return subprocess.run([str(c) for c in cmd], **kwargs)


def exit_status(rc):
    """Map a signal death (-N) to the conventional 128+N exit status."""
    return 128 - rc if rc < 0 else rc


def host_machine():
    m = os.uname().machine.lower()
    return {"amd64": "x86_64", "arm64": "aarch64", "armv7l": "arm",
            "armv8l": "arm", "i686": "x86", "i386": "x86"}.get(m, m)


def host_os():
    """Vendor/OS part of a host triple, e.g. for `polyglot init`."""
    if sys.platform == "darwin":
        return "apple-darwin"
    if sys.platform.startswith("win"):
        return "pc-windows-msvc"
    return "unknown-linux-gnu"


def target_matches_host(target):
    """True when a --target triple refers to this host (for GCC silently-ok)."""
    if not target:
        return True
    arch = target.split("-")[0].lower()
    arch = {"amd64": "x86_64", "arm64": "aarch64", "armv7": "arm",
            "armv7l": "arm", "armhf": "arm", "i686": "x86"}.get(arch, arch)
    if arch != host_machine():
        return False
    if "linux" in target and os.uname().sysname.lower() != "linux":
        return False
    if os.uname().sysname.lower() == "linux":
        # same-arch triples for a *different* OS are cross builds too; the
        # host gcc cannot serve them silently.
        for tok in ("darwin", "macos", "mingw", "windows", "freebsd",
                    "netbsd", "openbsd", "solaris", "aix", "haiku"):
            if tok in target:
                return False
    return True


# --------------------------------------------------------------------------
# Toolchain discovery
# --------------------------------------------------------------------------

class Toolchain:
    """Locates the C/C++ compiler (clang or GCC) and auxiliary LLVM tools.

    Precedence for the C compiler:
      1. POLYGLOT_CC / POLYGLOT_CXX environment variables (absolute).
      2. --compiler clang|gcc forced selection on PATH / scan dirs.
      3. Auto discovery: PATH candidates in preference order, then
         well-known LLVM install directories.
    """

    def __init__(self, prefer="auto", defer=False, require=True):
        self.prefer = prefer
        self.cc_path = None
        self.cxx_path = None
        self.kind = None            # "clang" | "gcc"
        self.version = "unknown"
        self.found_off_path = False
        self._aux_cache = {}
        self._require = require
        if not defer:
            self._discover()

    # -- discovery ---------------------------------------------------------

    @staticmethod
    def _scan_dirs():
        dirs = []
        for pattern in SCAN_GLOBS:
            try:
                expanded = Path(pattern).expanduser()
                for d in sorted(Path("/").glob(str(expanded).lstrip("/"))):
                    dirs.append(d)
            except (OSError, ValueError):
                continue
        return dirs

    @staticmethod
    def _find_on_path(names):
        """First PATH hit among names, or None."""
        for name in names:
            p = shutil.which(name)
            if p:
                return Path(p)
        return None

    @classmethod
    def _find_by_names(cls, names):
        """Search PATH first, then well-known scan dirs, in name order."""
        for name in names:
            p = shutil.which(name)
            if p:
                return Path(p), False
        for d in cls._scan_dirs():
            for name in names:
                cand = d / name
                try:
                    if cand.is_file() and os.access(cand, os.X_OK):
                        return cand, True
                except OSError:
                    continue
        return None, False

    def _detect_kind_and_version(self):
        try:
            proc = run_cmd([self.cc_path, "--version"], capture_output=True,
                           text=True, timeout=30)
            out = (proc.stdout or "") + (proc.stderr or "")
        except (OSError, subprocess.SubprocessError) as exc:
            raise PolyglotError("cannot execute compiler %s: %s"
                                % (self.cc_path, exc))
        low = out.lower()
        first = (out.strip().splitlines() or ["unknown"])[0].strip()
        self.version = first
        if "clang" in low:
            self.kind = "clang"
        elif "gcc" in low or "free software foundation" in low:
            self.kind = "gcc"
        else:
            raise PolyglotError(
                "unrecognized compiler backend at %s (use --compiler clang|gcc)"
                % self.cc_path)

    def _discover(self):
        env_cc = os.environ.get("POLYGLOT_CC")

        if self.prefer == "clang":
            names = CLANG_ONLY_NAMES
        elif self.prefer == "gcc":
            names = GCC_ONLY_NAMES
        else:
            names = C_COMPILER_NAMES

        cc, off_path = self._find_by_names(names)
        if env_cc:
            cc, off_path = Path(env_cc), False
        if cc is None:
            if self._require:
                raise MissingToolError(
                    "a C compiler (%s)" % "/".join(names[:3] + ["..."]),
                    searched="PATH, " + ", ".join(SCAN_GLOBS),
                    purpose="all polyglot commands")
            self.cc_path = None      # discovery state saved for doctor/version
            self.found_off_path = False
            return
        if not off_path and env_cc is None and self.prefer != "auto":
            # forced selection also accepts scan-dir hits
            pass
        self.cc_path = cc
        self.found_off_path = off_path
        self._detect_kind_and_version()
        self._discover_cxx()

    def _discover_cxx(self):
        """Locate the C++ compiler (same family preferred, other fallback)."""
        if self.cxx_path is not None:
            return
        env_cxx = os.environ.get("POLYGLOT_CXX")
        if env_cxx:
            self.cxx_path = Path(env_cxx)
            return
        if self.prefer == "clang":
            cxx_names = CLANGXX_ONLY_NAMES
        elif self.prefer == "gcc":
            cxx_names = GCCXX_ONLY_NAMES
        elif self.kind == "clang":
            cxx_names = CLANGXX_ONLY_NAMES + GCCXX_ONLY_NAMES
        else:
            cxx_names = GCCXX_ONLY_NAMES + CLANGXX_ONLY_NAMES
        cxx = self._find_on_path(cxx_names)
        if cxx is None and self.cc_path is not None:
            # sibling pass: clang++ sitting next to the discovered clang
            for name in cxx_names:
                cand = self.cc_path.parent / name
                try:
                    if cand.is_file() and os.access(cand, os.X_OK):
                        cxx = cand
                        break
                except OSError:
                    continue
        if cxx is None:
            cxx, _ = self._find_by_names(cxx_names)
        self.cxx_path = cxx

    def ensure_discovered(self):
        """Run discovery lazily (build defers it until polyglot.toml is read).

        When a project's [compiler] section already supplied a C compiler,
        only the still-missing C++ compiler is looked up.
        """
        if self.cc_path is None:
            self._discover()
        else:
            self._discover_cxx()

    # -- auxiliary tools ---------------------------------------------------

    def find_tool(self, name):
        """Locate an auxiliary tool: PATH, then clang's own bin dir, then
        the well-known LLVM scan dirs.  Returns a Path or None."""
        if name in self._aux_cache:
            return self._aux_cache[name]
        found = None
        p = shutil.which(name)
        if p:
            found = Path(p)
        else:
            tried = []
            if self.cc_path:
                sibling = self.cc_path.parent / name
                tried.append(str(sibling))
                try:
                    if sibling.is_file() and os.access(sibling, os.X_OK):
                        found = sibling
                except OSError:
                    pass
            if found is None:
                for d in self._scan_dirs():
                    cand = d / name
                    tried.append(str(cand))
                    try:
                        if cand.is_file() and os.access(cand, os.X_OK):
                            found = cand
                            break
                    except OSError:
                        continue
        self._aux_cache[name] = found
        return found

    def tool_or_error(self, name, purpose):
        p = self.find_tool(name)
        if p is None:
            raise MissingToolError(name, searched="PATH and LLVM install dirs",
                                   purpose=purpose)
        return p

    def compiler_for(self, source_files):
        """Pick cc vs cxx by the suffixes present."""
        if any(Path(f).suffix in CXX_SUFFIXES for f in source_files):
            if self.cxx_path:
                return self.cxx_path
            raise MissingToolError("a C++ compiler (clang++/g++)",
                                   purpose="C++ sources")
        return self.cc_path

    def needs_target_ok(self, target):
        """Validate --target for this backend; raises on unsupported."""
        if not target or self.kind == "clang":
            return
        if not target_matches_host(target):
            raise PolyglotError(
                "GCC backend cannot target '%s': GCC needs a matching cross "
                "toolchain (e.g. aarch64-linux-gnu-gcc).\nHint: use clang for "
                "cross-compilation (--compiler clang)." % target)

    def apply_project_config(self, config):
        """Honour polyglot.toml [compiler] cc/cxx keys for project builds.

        POLYGLOT_CC / POLYGLOT_CXX environment variables keep absolute
        precedence over the config file.
        """
        comp = (config or {}).get("compiler") or {}
        changed = False

        def resolve(value):
            p = Path(value).expanduser()
            if not p.is_absolute():
                p = Path(shutil.which(value) or p)
            return p if p.exists() else None

        cc = comp.get("cc")
        if cc and not os.environ.get("POLYGLOT_CC"):
            p = resolve(cc)
            if p is not None:
                self.cc_path = p
                self.found_off_path = shutil.which("clang") is None \
                    and self.kind == "clang"
                changed = True
            else:
                raise PolyglotError("polyglot.toml [compiler] cc = '%s' does "
                                    "not resolve to an executable" % cc)
        cxx = comp.get("cxx")
        if cxx and not os.environ.get("POLYGLOT_CXX"):
            p = resolve(cxx)
            if p is not None:
                self.cxx_path = p
            else:
                raise PolyglotError("polyglot.toml [compiler] cxx = '%s' does "
                                    "not resolve to an executable" % cxx)
        if changed:
            self._detect_kind_and_version()

    def describe(self):
        return "%s (%s, %s)" % (self.cc_path, self.kind, self.version)


# --------------------------------------------------------------------------
# Flag construction (backend-aware)
# --------------------------------------------------------------------------

def validate_std(std, source_files):
    """Validate --std against the language implied by the source suffix."""
    if not std:
        return None
    is_cxx = any(Path(f).suffix in CXX_SUFFIXES for f in source_files)
    allowed = CXX_STDS if is_cxx else C_STDS
    if std not in allowed:
        lang = "C++" if is_cxx else "C"
        raise PolyglotError(
            "invalid --std '%s' for %s sources (choose from: %s)"
            % (std, lang, ", ".join(allowed)), EXIT_USAGE)
    return std


def default_std(source_files):
    """Per-suffix default standard when the user did not ask for one."""
    return "c++17" if any(Path(f).suffix in CXX_SUFFIXES for f in source_files) \
        else "c17"


def common_compile_args(tc, args, source_files, *, for_emit=False):
    """Build the shared flag list honored by both clang and GCC."""
    flags = []
    std = validate_std(getattr(args, "std", None), source_files) \
        or default_std(source_files)
    flags.append("-std=" + std)

    warn = getattr(args, "warn", "default") or "default"
    flags.extend(WARN_MAP.get(warn, WARN_MAP["default"]))
    if getattr(args, "werror", False):
        flags.append("-Werror")
    if getattr(args, "debug", False):
        flags.append("-g")

    sanitizers = getattr(args, "sanitize", None)
    if sanitizers:
        chosen = [s.strip() for s in sanitizers.split(",") if s.strip()]
        for s in chosen:
            if s not in SANITIZERS:
                raise PolyglotError(
                    "invalid sanitizer '%s' (choose from: %s)"
                    % (s, ", ".join(SANITIZERS)), EXIT_USAGE)
            if s == "memory" and tc.kind == "gcc":
                raise PolyglotError(
                    "-fsanitize=memory is clang-only; the GCC backend does not "
                    "support MemorySanitizer (use clang or drop 'memory').",
                    EXIT_USAGE)
        if chosen:
            flags.append("-fsanitize=" + ",".join(chosen))

    for inc in getattr(args, "includes", None) or []:
        flags.extend(["-I", str(inc)])
    for define in getattr(args, "defines", None) or []:
        flags.append("-D" + define)

    opt = OPT_MAP.get(getattr(args, "opt_level", "default"), "-O2")
    if opt == "-Oz" and tc.kind == "gcc":
        # -Oz needs gcc >= 12; -Os is valid everywhere and semantically
        # closest (mirrors the -fsanitize=memory backend guard above).
        opt = "-Os"
    flags.append(opt)

    target = getattr(args, "target", None)
    if target and tc.kind == "clang":
        flags.append("--target=" + target)
    else:
        tc.needs_target_ok(target)

    if for_emit and tc.kind == "clang":
        flags.append("-fno-discard-value-names")

    # User-supplied raw flags go last: compilers honor the final -O/-f...,
    # so an explicit --cc-arg=-O0 must win over the driver's default.
    for raw in getattr(args, "cc_args", None) or []:
        flags.append(raw)
    return flags


def link_args(args, tc):
    """Library search paths / libraries for the link step."""
    flags = []
    for libdir in getattr(args, "lib_dirs", None) or []:
        flags.extend(["-L", str(libdir)])
    for lib in getattr(args, "libs", None) or []:
        flags.extend(["-l", str(lib)])
    return flags


def log_running(cmd, args):
    if getattr(args, "quiet", False):
        return
    print("Running: %s" % quote(cmd))


# --------------------------------------------------------------------------
# Incremental build cache
# --------------------------------------------------------------------------

class BuildCache:
    """Content-addressed object cache stored in <project>/.polyglot-cache/."""

    def __init__(self, project_dir, enabled=True):
        self.enabled = enabled
        self.dir = Path(project_dir) / ".polyglot-cache"
        self.manifest_path = self.dir / "manifest.json"
        self._manifest = None

    def _load_manifest(self):
        if self._manifest is None:
            try:
                self._manifest = json.loads(self.manifest_path.read_text())
            except (OSError, ValueError):
                self._manifest = {}
        return self._manifest

    @staticmethod
    def key(tc, flags, source, project_dir):
        """sha256 of (compiler path+version, flags, preprocessed TU, includes).

        The preprocessed translation unit is hashed (ccache's preprocessor
        mode) so a change to *any* included header invalidates the entry;
        old entries simply miss.  When preprocessing fails, the raw source
        bytes are hashed as a fallback.
        """
        import hashlib
        src = Path(source)
        content = None
        try:
            proc = run_cmd([str(tc.compiler_for([src]))]
                           + [str(f) for f in flags]
                           + ["-E", str(Path(source).resolve())],
                           capture_output=True, text=True, timeout=120)
            if proc.returncode == 0 and proc.stdout:
                content = proc.stdout.encode("utf-8", "surrogateescape")
        except (OSError, subprocess.SubprocessError):
            content = None
        if content is None:
            content = src.read_bytes()
        h = hashlib.sha256()
        payload = {
            "compiler": str(tc.cc_path),
            "version": tc.version,
            "flags": flags,
            "source": str(Path(source).resolve()),
            "bytes": hashlib.sha256(content).hexdigest(),
            "project": str(Path(project_dir).resolve()),
        }
        h.update(json.dumps(payload, sort_keys=True).encode())
        return h.hexdigest()

    def object_path(self, key):
        return self.dir / (key + ".o")

    def get(self, key):
        if not self.enabled:
            return None
        obj = self.object_path(key)
        if obj.is_file() and key in self._load_manifest():
            return obj
        return None

    def store(self, key, source, flags, tmp_obj):
        """Move a freshly compiled object into the cache (atomic rename)."""
        if not self.enabled:
            return
        try:
            self.dir.mkdir(parents=True, exist_ok=True)
            obj = self.object_path(key)
            os.replace(tmp_obj, obj)   # same dir -> atomic on POSIX
            manifest = self._load_manifest()
            manifest[key] = {
                "source": str(source),
                "flags": flags,
                "created": time.strftime("%Y-%m-%dT%H:%M:%S"),
            }
            tmp_m = self.dir / ("manifest.%d.json.tmp" % os.getpid())
            tmp_m.write_text(json.dumps(manifest, indent=1, sort_keys=True))
            os.replace(tmp_m, self.manifest_path)
        except OSError:
            pass  # cache is best-effort; a failed store must not fail builds

    def clear(self):
        removed = 0
        if self.dir.is_dir():
            for f in self.dir.iterdir():
                try:
                    if f.is_file():
                        f.unlink()
                        removed += 1
                except OSError:
                    pass
        return removed


# --------------------------------------------------------------------------
# Core compile / link machinery
# --------------------------------------------------------------------------

def invoke_compiler(cmd, args, what="compilation"):
    log_running(cmd, args)
    proc = run_cmd(cmd)
    if proc.returncode != 0:
        raise PolyglotError("%s failed with exit code %d"
                            % (what, proc.returncode), proc.returncode or EXIT_FAILURE)
    return proc


def compile_object(tc, source, out_obj, args, extra_flags):
    """One translation unit -> one .o file."""
    compiler = tc.compiler_for([source])
    cmd = [compiler] + extra_flags + ["-c", str(source), "-o", str(out_obj)]
    invoke_compiler(cmd, args)


def compile_to_exe(tc, sources, output, args, extra_flags, for_project=False):
    """Build executable (or shared/static lib) from sources.

    Single TU with --no-cache -> one direct compiler invocation.
    Otherwise every TU is compiled to a (cached) .o file - optionally in
    parallel via -j - and then linked by one final compiler invocation.
    """
    shared = getattr(args, "shared", False)
    static_lib = getattr(args, "static_lib", False)

    project_dir = Path(getattr(args, "_project_dir", None) or Path.cwd())
    cache = BuildCache(project_dir, enabled=not getattr(args, "no_cache", False))
    if cache.enabled:
        try:
            cache.dir.mkdir(parents=True, exist_ok=True)
        except OSError:
            cache.enabled = False

    def one(src):
        flags = list(extra_flags)
        if shared and "-fPIC" not in flags:
            # position-independent code is required for every TU of a
            # .so, not just at the link step
            flags.append("-fPIC")
        key = BuildCache.key(tc, flags, src, project_dir)
        cached = cache.get(key)
        if cached is not None:
            if getattr(args, "verbose", False):
                print(yellow("cache HIT  %s" % src))
            return cached
        if getattr(args, "verbose", False):
            print("cache MISS %s" % src)
        if cache.enabled:
            # pid+thread-unique scratch name; store() atomically renames it
            tmp_obj = cache.object_path("%s.%d.%d.tmp"
                                        % (key, os.getpid(),
                                           threading.get_ident()))
        else:
            fd, tmp_name = tempfile.mkstemp(suffix=".o")
            os.close(fd)
            tmp_obj = Path(tmp_name)
            no_cache_temps.append(tmp_obj)
        compile_object(tc, src, tmp_obj, args, flags)
        if cache.enabled:
            cache.store(key, src, flags, tmp_obj)
            return cache.object_path(key)
        return tmp_obj

    no_cache_temps = []
    try:
        if len(sources) == 1 and not cache.enabled and not shared \
                and not static_lib:
            compiler = tc.compiler_for(sources)
            cmd = [compiler] + extra_flags + link_args(args, tc)
            cmd += [str(s) for s in sources] + ["-o", str(output)]
            invoke_compiler(cmd, args)
            return

        workers = max(1, int(getattr(args, "jobs", 1) or 1))
        if len(sources) > 1 and workers > 1:
            with ThreadPoolExecutor(max_workers=workers) as pool:
                objects = list(pool.map(one, sources))
        else:
            objects = [one(s) for s in sources]

        if static_lib:
            ar = tc.find_tool("llvm-ar") or shutil.which("ar")
            if ar is None:
                raise MissingToolError("ar or llvm-ar",
                                       purpose="static library builds")
            out_lib = Path(output)
            if out_lib.suffix != ".a":
                # user gave a bare name: normalize to lib<name>.a
                if not out_lib.name.startswith("lib"):
                    out_lib = out_lib.parent / ("lib" + out_lib.name)
                out_lib = out_lib.with_suffix(".a")
            cmd = [str(ar), "rcs", str(out_lib)] + [str(o) for o in objects]
            invoke_compiler(cmd, args, what="archiving")
            print("Built static library %s" % out_lib)
            return

        compiler = tc.compiler_for(sources)
        cmd = [compiler] + extra_flags
        if shared:
            cmd += ["-shared", "-fPIC"]
        cmd += [str(o) for o in objects] + link_args(args, tc) \
            + ["-o", str(output)]
        invoke_compiler(cmd, args, what="linking")
    finally:
        # --no-cache compiles into one-shot mkstemp files: unlink them so
        # repeated builds (e.g. watch mode) do not leak objects into /tmp.
        for t in no_cache_temps:
            try:
                t.unlink(missing_ok=True)
            except OSError:
                pass


# --------------------------------------------------------------------------
# Plugin architecture: JSON-RPC 2.0 over stdio
# --------------------------------------------------------------------------
# A plugin is an executable speaking the protocol implemented by
# crates/polyglot-protocol: newline-delimited JSON-RPC 2.0 on stdin/stdout
# (one object per line), human logs on stderr.  Methods: initialize,
# compile, shutdown (calls) and exit (notification).  See
# docs/user-guide/commands.md "Plugin architecture".

# Keep in sync with crates/polyglot-protocol/src/types.rs PROTOCOL_VERSION.
PLUGIN_PROTOCOL_VERSION = "0.1.0"

# driver --opt-level name -> protocol OptLevel (serde lowercase spelling)
PLUGIN_OPT_LEVEL = {
    "none": "none", "less": "less", "default": "default",
    "aggressive": "aggressive", "size": "size",
    "size-aggressive": "sizeaggressive",
}

C_CPP_SUFFIXES = {".c", ".h", ".cpp", ".cc", ".cxx", ".hpp", ".c++"}


class PluginError(PolyglotError):
    """A plugin could not be found, executed, spoken to, or trusted."""


class PluginClient:
    """Minimal JSON-RPC 2.0 client for one plugin process over stdio.

    Requests are written to the plugin's stdin, responses read from its
    stdout, one JSON object per line; the plugin's stderr is inherited so
    its diagnostics reach the user directly.  A background thread drains
    stdout so every request carries a deadline, and stray non-JSON lines
    on the stream are skipped rather than fatal.
    """

    def __init__(self, command, timeout=120.0):
        self.command = str(command)
        self.timeout = timeout
        self._next_id = 1
        self._lines = queue.Queue()
        try:
            self.proc = subprocess.Popen(
                [self.command],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=None,
                text=True, bufsize=1)
        except OSError as exc:
            raise PluginError("cannot execute plugin %s: %s" % (command, exc),
                              EXIT_MISSING_TOOL)
        self._reader = threading.Thread(target=self._read_loop, daemon=True)
        self._reader.start()

    def _read_loop(self):
        """Drain the plugin's stdout into a queue (None = EOF sentinel)."""
        while True:
            line = self.proc.stdout.readline()
            self._lines.put(line.rstrip("\n") if line else None)
            if not line:
                return

    def _recv(self, want_id, timeout):
        deadline = time.time() + timeout
        while True:
            remaining = deadline - time.time()
            if remaining <= 0:
                raise PluginError("plugin %s did not respond within %ss"
                                  % (self.command, int(timeout)))
            try:
                line = self._lines.get(timeout=remaining)
            except queue.Empty:
                continue
            if line is None:
                raise PluginError(
                    "plugin %s closed its output before answering "
                    "(is it a polyglot plugin?)" % self.command)
            try:
                msg = json.loads(line)
            except ValueError:
                continue          # tolerate stray non-JSON stream noise
            if not isinstance(msg, dict) or msg.get("id") != want_id:
                continue          # notification or unrelated response
            if "error" in msg:
                rpc_err = msg.get("error") or {}
                raise PluginError("plugin error %s: %s"
                                  % (rpc_err.get("code"),
                                     rpc_err.get("message", "")))
            return msg.get("result")

    def request(self, method, params=None, timeout=None):
        rid = self._next_id
        self._next_id += 1
        req = {"jsonrpc": "2.0", "id": rid, "method": method}
        if params is not None:
            req["params"] = params
        try:
            self.proc.stdin.write(json.dumps(req) + "\n")
            self.proc.stdin.flush()
        except (BrokenPipeError, OSError, ValueError) as exc:
            raise PluginError("plugin %s stopped accepting requests: %s"
                              % (self.command, exc))
        return self._recv(rid, timeout or self.timeout)

    def initialize(self):
        """Handshake; returns the plugin's InitializeResult dict."""
        result = self.request("initialize", {
            "protocol_version": PLUGIN_PROTOCOL_VERSION,
            "capabilities": {"mlir_dialects": [], "source_extensions": [],
                             "languages": [], "incremental": False},
        }, timeout=30.0)
        version = (result or {}).get("protocol_version")
        if not isinstance(result, dict) or version != PLUGIN_PROTOCOL_VERSION:
            raise PluginError(
                "plugin %s speaks protocol %r but this driver expects %r\n"
                "Hint: rebuild the plugin: cargo build --release -p polyglot-clang"
                % (self.command, version, PLUGIN_PROTOCOL_VERSION),
                EXIT_MISSING_TOOL)
        return result

    def compile(self, params):
        """Compile one translation unit; returns the CompileResult dict."""
        return self.request("compile", params)

    def close(self):
        """shutdown call + exit notification, then reap the process."""
        try:
            self.request("shutdown", timeout=10.0)
        except Exception:
            pass
        try:
            self.proc.stdin.write(
                json.dumps({"jsonrpc": "2.0", "method": "exit"}) + "\n")
            self.proc.stdin.flush()
        except (BrokenPipeError, OSError, ValueError):
            pass
        try:
            self.proc.stdin.close()
        except (OSError, AttributeError):
            pass
        try:
            self.proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.proc.kill()
            try:
                self.proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                pass


def resolve_plugin(name, plugin_dir):
    """Find a plugin binary; returns a Path or None.

    Resolution order: an explicit path when NAME contains a path separator,
    then NAME (and polyglot-NAME, the manifest's command naming) under
    --plugin-dir, then under the workspace target/release directory, then
    PATH.
    """
    if "/" in name or "\\" in name:
        p = Path(name).expanduser()
        return p if (p.is_file() and os.access(p, os.X_OK)) else None
    names = [name]
    if not name.startswith("polyglot-"):
        names.append("polyglot-" + name)
    roots = [Path(plugin_dir).expanduser()]
    script_dir = Path(__file__).resolve().parent
    for base in (script_dir / "target" / "release",
                 Path.cwd() / "target" / "release"):
        if base not in roots:
            roots.append(base)
    for root in roots:
        for n in names:
            for cand in (root / n, root / (n + ".exe")):
                try:
                    if cand.is_file() and os.access(cand, os.X_OK):
                        return cand
                except OSError:
                    continue
    for n in names:
        found = shutil.which(n)
        if found:
            return Path(found)
    return None


def plugin_or_missing(name, plugin_dir):
    """Resolve a mandatory --plugin value or fail with exit 3."""
    plugin = resolve_plugin(name, plugin_dir)
    if plugin is None:
        raise PluginError(
            "plugin '%s' not found (searched --plugin-dir, target/release, "
            "PATH)\nHint: build it with: cargo build --release -p "
            "polyglot-clang\nor pass an explicit path: --plugin "
            "/path/to/polyglot-clang" % name, EXIT_MISSING_TOOL)
    return plugin


def choose_plugin(args, config, sources):
    """Which plugin binary should build these sources, or None.

    An explicit --plugin is mandatory: when it is missing or cannot serve
    the languages involved the build fails (exit 3) or falls back with a
    warning for non-C/C++ sources.  Plugins listed in polyglot.toml
    [plugins] are best-effort: a missing one warns and the build falls
    back to the direct compiler.
    """
    plugin_dir = getattr(args, "plugin_dir", None) or "~/.polyglot/plugins"
    explicit = getattr(args, "plugin", None)
    if explicit:
        plugin = plugin_or_missing(explicit, plugin_dir)
        if any(Path(s).suffix not in C_CPP_SUFFIXES for s in sources):
            print(yellow("warning: plugin '%s' handles C/C++ sources; using "
                         "the direct compiler" % explicit))
            return None
        return plugin
    wanted = (config or {}).get("plugins") or {}
    if not wanted or not all(Path(s).suffix in C_CPP_SUFFIXES for s in sources):
        return None
    for name in wanted:
        plugin = resolve_plugin(name, plugin_dir)
        if plugin is None:
            err_print("warning: plugin '%s' (polyglot.toml [plugins]) not "
                      "found; falling back to the direct compiler "
                      "(build it with: cargo build --release -p polyglot-%s)"
                      % (name, name))
            continue
        return plugin
    return None


def format_plugin_diagnostics(diags):
    """Render plugin Diagnostic objects the way compilers do."""
    lines = []
    for d in diags or []:
        loc = d.get("location") or {}
        where = ""
        if loc.get("file"):
            where = "%s:%s:%s: " % (loc.get("file"), loc.get("line", 0),
                                    loc.get("column", 0))
        lines.append("%s%s: %s" % (where, d.get("severity", "error"),
                                   d.get("message", "")))
    return "\n".join(lines)


def plugin_link_cc(tc, sources):
    """A clang able to turn plugin-emitted LLVM IR into machine code.

    C++ sources must link via clang++ (or clang driving C++ mode) so the
    C++ runtime is pulled in; `clang file.ll` links as C and leaves
    std:: symbols undefined.  g++ can never be used here: it cannot
    consume LLVM IR.
    """
    if any(Path(s).suffix in CXX_SUFFIXES for s in sources):
        if tc.kind == "clang" and tc.cxx_path:
            return tc.cxx_path
        if tc.cc_path:
            sibling = tc.cc_path.parent / "clang++"
            try:
                if sibling.is_file() and os.access(sibling, os.X_OK):
                    return sibling
            except OSError:
                pass
        found, _ = Toolchain._find_by_names(CLANGXX_ONLY_NAMES)
        if found:
            return found
    if tc.kind == "clang" and tc.cc_path:
        return tc.cc_path
    found, _ = Toolchain._find_by_names(CLANG_ONLY_NAMES)
    return found


def build_with_plugin(tc, plugin, sources, output, args):
    """Compile every TU through the plugin and link the returned IR.

    The clang plugin returns in-memory LLVM IR text (CompileResult
    .mlir_module, emitted via `clang -S -emit-llvm`), so each result is
    written to a temporary .ll and handed back to a real clang for
    codegen + linking.
    """
    name = Path(plugin).name
    flags = [f for f in common_compile_args(tc, args, sources)
             if not f.startswith("--target=")]
    if getattr(args, "shared", False) and "-fPIC" not in flags:
        flags.append("-fPIC")
    target = getattr(args, "target", None) \
        or (host_machine() + "-" + host_os())
    opt = PLUGIN_OPT_LEVEL.get(getattr(args, "opt_level", "default"),
                               "default")

    client = PluginClient(plugin)
    try:
        try:
            info = client.initialize()
        except PluginError as exc:
            exc.exit_code = EXIT_MISSING_TOOL
            raise
        meta = (info.get("plugin_info") or {})
        if getattr(args, "verbose", False):
            print("plugin         %s v%s (protocol %s)"
                  % (meta.get("name", name), meta.get("version", "?"),
                     info.get("protocol_version", "?")))
        try:
            ir_texts = []
            for src in sources:
                result = client.compile({
                    "source_path": str(Path(src).resolve()),
                    "args": flags,
                    "target_triple": target,
                    "opt_level": opt,
                    "diagnostics": True,
                })
                errors = [d for d in (result.get("diagnostics") or [])
                          if d.get("severity") == "error"]
                if errors:
                    raise PluginError(format_plugin_diagnostics(errors),
                                      EXIT_FAILURE)
                ir = result.get("mlir_module")
                if not isinstance(ir, str) or not ir.strip():
                    raise PluginError("plugin returned no IR module for %s"
                                      % src, EXIT_FAILURE)
                ir_texts.append(ir)
        except PluginError as exc:
            raise PluginError("plugin '%s' compilation failed:\n%s"
                              % (name, exc), EXIT_FAILURE)
        except Exception as exc:
            raise PluginError("plugin '%s' failed: %r" % (name, exc))
    finally:
        client.close()

    link_cc = plugin_link_cc(tc, sources)
    if link_cc is None:
        raise MissingToolError("clang",
                               purpose="linking plugin-emitted LLVM IR")
    with tempfile.TemporaryDirectory() as tmpdir:
        ll_files = []
        for src, ir in zip(sources, ir_texts):
            ll = Path(tmpdir) / (Path(src).stem + ".ll")
            ll.write_text(ir)
            ll_files.append(ll)
        if getattr(args, "static_lib", False):
            objects = []
            for ll in ll_files:
                obj = Path(tmpdir) / (ll.stem + ".o")
                invoke_compiler([str(link_cc), "-c", str(ll), "-o", str(obj)],
                                args, what="plugin IR object emission")
                objects.append(obj)
            ar = tc.find_tool("llvm-ar") or shutil.which("ar")
            if ar is None:
                raise MissingToolError("ar or llvm-ar",
                                       purpose="static library builds")
            out_lib = Path(output)
            if out_lib.suffix != ".a":
                if not out_lib.name.startswith("lib"):
                    out_lib = out_lib.parent / ("lib" + out_lib.name)
                out_lib = out_lib.with_suffix(".a")
            invoke_compiler([str(ar), "rcs", str(out_lib)]
                            + [str(o) for o in objects],
                            args, what="archiving")
            print("Built static library %s (via plugin %s)" % (out_lib, name))
            return
        cmd = [str(link_cc)]
        if getattr(args, "shared", False):
            cmd += ["-shared", "-fPIC"]
        cmd += [str(f) for f in ll_files] + link_args(args, tc) \
            + ["-o", str(output)]
        invoke_compiler(cmd, args, what="linking plugin IR")
    print("Built %s -> %s (via plugin %s)"
          % (", ".join(str(s) for s in sources), output, name))


def find_project_dir(paths):
    """Return (project_dir, config) when a polyglot.toml project was given."""
    if len(paths) == 1 and Path(paths[0]).is_dir():
        cfg = Path(paths[0]) / "polyglot.toml"
        if cfg.exists() and toml is not None:
            try:
                return Path(paths[0]), toml.load(cfg)
            except Exception as exc:
                err_print("warning: could not parse %s: %s" % (cfg, exc))
    return None, None


def project_sources_and_output(project_dir, config, default_output):
    """Resolve [[bin]] / [language] config to (sources, output)."""
    bins = config.get("bin", [])
    output = default_output
    if bins and bins[0].get("name"):
        output = project_dir / bins[0]["name"]

    language = (config.get("language") or {})
    if language.get("rust"):
        src_dir = project_dir / "src"
        rust_src = src_dir / "main.rs"
        if rust_src.exists():
            return [rust_src], output
        return [], output
    # Every translation unit under src/ is part of the binary; skipping any
    # of them would fail the link with undefined references.
    sources = []
    for ext in [".c", ".cpp", ".cc", ".cxx"]:
        sources.extend(sorted((project_dir / "src").glob("*" + ext)))
    if bins and "source" in bins[0]:
        primary = project_dir / bins[0]["source"]
        try:
            known = {f.resolve() for f in sources}
            dup = primary.resolve() in known
        except OSError:
            dup = primary in sources
        if not dup:
            sources.insert(0, primary)
    return sources, output


# --------------------------------------------------------------------------
# Commands: build / run / check / emit-ir / emit-asm / preproc / deps
# --------------------------------------------------------------------------

def resolve_build_inputs(args):
    """Shared input resolution for build-like commands.

    Returns (sources, output, project_dir).  Exits friendly on bad inputs.
    """
    paths = [Path(p) for p in (args.paths or ["."])]
    output = Path(args.output) if getattr(args, "output", None) else None

    project_dir, config = find_project_dir(paths)
    if project_dir is not None:
        sources, proj_out = project_sources_and_output(project_dir, config,
                                                       output or Path("a.out"))
        args._project_dir = str(project_dir)
        if not sources:
            raise PolyglotError("No source file found in project at %s"
                                % project_dir)
        for f in sources:
            if not Path(f).exists():
                raise PolyglotError("Source file not found: %s" % f)
        return sources, proj_out, project_dir, config

    if not paths:
        raise PolyglotError("nothing to build", EXIT_USAGE)
    sources = []
    for f in paths:
        f = Path(f)
        if not f.exists():
            raise PolyglotError("Source file not found: %s" % f)
        if f.is_dir():
            raise PolyglotError("Expected source file, got directory: %s" % f)
        sources.append(f)

    if output is None:
        output = sources[0].with_suffix("") if len(sources) == 1 else Path("a.out")
    return sources, output, Path.cwd(), None


def build_rust_project(tc, sources, output, args):
    rustc = tc.find_tool("rustc")
    if rustc is None:
        raise MissingToolError("rustc", purpose="Rust builds")
    cmd = [str(rustc), RUST_OPT_MAP.get(args.opt_level, "-Copt-level=2")]
    cmd += [str(s) for s in sources] + ["-o", str(output)]
    invoke_compiler(cmd, args)


def cmd_build(tc, args):
    sources, output, project_dir, config = resolve_build_inputs(args)
    if config:
        tc.apply_project_config(config)
    if config and (config.get("language") or {}).get("rust"):
        build_rust_project(tc, sources, output, args)
        return
    # discovery was deferred so polyglot.toml's [compiler] cc/cxx could take
    # effect first; run it now (no-op when the config already supplied one)
    tc.ensure_discovered()
    plugin = choose_plugin(args, config, sources)
    if plugin is not None:
        try:
            build_with_plugin(tc, plugin, sources, output, args)
            return
        except PluginError as exc:
            if getattr(args, "plugin", None):
                raise          # an explicit --plugin is mandatory
            err_print("warning: plugin '%s' unusable (%s); falling back to "
                      "the direct compiler" % (Path(plugin).name, exc))
    extra = common_compile_args(tc, args, sources)
    compile_to_exe(tc, sources, output, args, extra)
    if not getattr(args, "static_lib", False):
        print("Built %s -> %s" % (", ".join(str(s) for s in sources), output))


def split_program_args(raw_args):
    """Drop a single leading '--' separator, if present."""
    if raw_args and raw_args[0] == "--":
        return raw_args[1:]
    return list(raw_args)


def cmd_run(tc, args):
    sources = [Path(args.file)]
    if not sources[0].exists():
        raise PolyglotError("Source file not found: %s" % sources[0])
    args._project_dir = str(Path.cwd())
    with tempfile.TemporaryDirectory() as tmpdir:
        exe = Path(tmpdir) / "polyglot_run"
        if sources[0].suffix == ".rs":
            build_rust_project(tc, sources, exe, args)
        else:
            extra = common_compile_args(tc, args, sources)
            compile_to_exe(tc, sources, exe, args, extra)
        program = [str(exe)] + split_program_args(args.args or [])
        proc = run_cmd(program)
        sys.exit(exit_status(proc.returncode))


def cmd_check(tc, args):
    failures = 0
    sources = [Path(p) for p in args.paths]
    for f in sources:
        if not f.exists():
            raise PolyglotError("Source file not found: %s" % f)
    for f in sources:
        print("Checking %s..." % f)
        compiler = tc.compiler_for([f])
        cmd = [compiler, "-fsyntax-only"] + common_compile_args(tc, args, [f])
        cmd += [str(f)]
        log_running(cmd, args)
        proc = run_cmd(cmd)
        if proc.returncode == 0:
            print(green("OK   %s" % f))
        else:
            print(red("FAIL %s" % f))
            failures += 1
    if failures:
        raise PolyglotError("syntax check failed for %d file(s)" % failures,
                            EXIT_FAILURE)
    print("All files passed syntax check")


_PATH_FLAG_PAIRS = ("I", "isystem", "iquote", "include", "idirafter", "L")


def _absolutize_path_flags(flags, base):
    """Rewrite path-bearing flags to absolute form (against `base`).

    Needed because the GCC emit-ir path runs the compiler inside a temporary
    directory: relative -I/-include/-L values would otherwise resolve there
    and break the build.
    """
    out = []
    i = 0
    while i < len(flags):
        f = str(flags[i])
        if f in ["-%s" % n for n in _PATH_FLAG_PAIRS] and i + 1 < len(flags):
            p = Path(flags[i + 1])
            out.append(f)
            out.append(str(p if p.is_absolute() else (base / p).resolve()))
            i += 2
            continue
        if len(f) > 2 and f[0] == "-" and f[1] in "IL" and f[2] != "=":
            p = Path(f[2:])
            if not p.is_absolute():
                out.append(f[:2] + str((base / p).resolve()))
                i += 1
                continue
        out.append(f)
        i += 1
    return out


def _emit_ir_one(tc, src, args, out_path):
    """Emit IR for one TU.  clang -> LLVM IR (.ll); gcc -> GIMPLE dump."""
    compiler = tc.compiler_for([src])
    extra = common_compile_args(tc, args, [src], for_emit=True)
    if tc.kind == "clang":
        cmd = [compiler] + extra + ["-S", "-emit-llvm", str(src)]
        if out_path:
            cmd += ["-o", str(out_path)]
        invoke_compiler(cmd, args, what="IR emission")
        dest = out_path or Path.cwd() / (Path(src).stem + ".ll")
        print("Wrote LLVM IR %s" % dest)
        return
    # GCC: GIMPLE dumps are written to the current directory, so run inside
    # a scratch dir and fish the dump out afterwards.  The compiler's cwd
    # changes, so relative user paths must be absolutized first.
    extra = _absolutize_path_flags(extra, Path.cwd())
    src_abs = Path(src).resolve()
    with tempfile.TemporaryDirectory() as tmpdir:
        cmd = [compiler] + extra + ["-fdump-tree-gimple", "-S", str(src_abs),
                                    "-o", str(Path(tmpdir) / "out")]
        log_running(cmd, args)
        proc = run_cmd(cmd, cwd=tmpdir)
        if proc.returncode != 0:
            raise PolyglotError("IR emission failed with exit code %d"
                                % proc.returncode, proc.returncode or EXIT_FAILURE)
        dumps = sorted(Path(tmpdir).glob("*.gimple"))
        if not dumps:
            raise PolyglotError("GCC produced no GIMPLE dump for %s" % src)
        dest = out_path or Path.cwd() / (Path(src).stem + ".gimple")
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(dumps[-1], dest)
        print(yellow("note: GCC backend emits GIMPLE (not LLVM IR) -> %s" % dest))


def cmd_emit_ir(tc, args):
    for src in [Path(p) for p in args.paths]:
        if not src.exists():
            raise PolyglotError("Source file not found: %s" % src)
    out = Path(args.output) if args.output else None
    if out is not None and len(args.paths) > 1:
        raise PolyglotError("-o with multiple sources is ambiguous; emit one "
                            "file at a time", EXIT_USAGE)
    ext = ".ll" if tc.kind == "clang" else ".gimple"
    seen = {}
    for src in [Path(p) for p in args.paths]:
        out_path = out
        if out is None:
            # duplicate stems would overwrite each other's default dump
            # (cwd/<stem><ext>); disambiguate with the parent directory
            stem = Path(src).stem
            if stem in seen and seen[stem].resolve() != Path(src).resolve():
                parts = [q for q in Path(src).parent.parts
                         if q not in ("/", ".")]
                prefix = "_".join(parts)
                name = ((prefix + "_") if prefix else "dup_") + stem + ext
                out_path = Path.cwd() / name
            seen[stem] = Path(src)
        _emit_ir_one(tc, src, args, out_path)


