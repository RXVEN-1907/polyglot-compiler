def cmd_analyze(tc, args):
    if tc.kind != "clang":
        raise PolyglotError(
            "the static analyzer requires the clang backend "
            "(retry with: polyglot --compiler clang analyze ...)",
            EXIT_MISSING_TOOL)
    bad = []
    with tempfile.TemporaryDirectory() as tmpdir:
        for i, f in enumerate(args.paths):
            if not Path(f).exists():
                raise PolyglotError("Source file not found: %s" % f)
            # reports go to a scratch dir: --analyze exits 0 even when it
            # finds defects, and without -o a stray <name>.plist would be
            # dropped into the current directory
            report = Path(tmpdir) / ("report_%d.plist" % i)
            cmd = [str(tc.cc_path), "--analyze", "-o", str(report), str(f)]
            log_running(cmd, args)
            proc = run_cmd(cmd, capture_output=True, text=True)
            sys.stderr.write(proc.stderr or "")
            if proc.returncode != 0:
                bad.append(str(f))
                continue
            try:
                with open(report, "rb") as fh:
                    data = plistlib.load(fh)
            except (OSError, ValueError, plistlib.InvalidFileException):
                data = {}
            if data.get("diagnostics"):
                bad.append(str(f))
    if bad:
        raise PolyglotError("static analysis reported issues in: %s"
                            % ", ".join(bad), EXIT_FAILURE)


def cmd_watch(tc, args):
    src = Path(args.file)
    if not src.exists():
        raise PolyglotError("Source file not found: %s" % src)
    tmpdir = tempfile.mkdtemp(prefix="polyglot_watch_")
    exe = Path(tmpdir) / "watch_out"
    quiet = args.quiet
    args.quiet = True          # watch output stays readable
    deadline = time.time() + args.timeout if args.timeout else None
    last_mtime = None

    def stamp():
        return time.strftime("%H:%M:%S")

    def rebuild():
        t0 = time.time()
        try:
            extra = common_compile_args(tc, args, [src])
            compile_to_exe(tc, [src], exe, args, extra)
            ms = int((time.time() - t0) * 1000)
            print(green("[%s] rebuilt ok (%dms)" % (stamp(), ms)))
        except PolyglotError as exc:
            print(red("[%s] rebuild failed: %s" % (stamp(), exc)))

    try:
        rebuild()
        last_mtime = src.stat().st_mtime
        while True:
            time.sleep(0.5)
            try:
                mtime = src.stat().st_mtime
            except OSError:
                continue
            if mtime != last_mtime:
                last_mtime = mtime
                rebuild()
            if deadline and time.time() >= deadline:
                break
    finally:
        args.quiet = quiet
        shutil.rmtree(tmpdir, ignore_errors=True)
    # Ctrl-C propagates to main()'s handler ("Interrupted.", exit 130)


