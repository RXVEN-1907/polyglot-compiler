}
'''

    (project_dir / "polyglot.toml").write_text(config)
    src_dir = project_dir / "src"
    src_dir.mkdir(exist_ok=True)
    (src_dir / ("main." + ext)).write_text(sample)
    (project_dir / ".gitignore").write_text(GITIGNORE_STUB)
    (project_dir / "README.md").write_text(
        "# %s\n\nA Polyglot project (created by `polyglot init --language %s`).\n"
        "\n## Build\n\n    polyglot build\n\n## Run\n\n    polyglot run src/main.%s\n"
        % (project_name, language, ext))

    print("Project created at: %s" % project_dir)
    print("Run 'polyglot build' to build.")


def cmd_clean(tc, args):
    project_dir = Path(args.path)
    removed = 0
    patterns = ["*.o", "*.obj", "*.exe", "a.out", "*.ll", "*.s", "*.bc"]
    for pattern in patterns:
        for f in project_dir.glob(pattern):
            if f.is_file():
                try:
                    f.unlink()
                    print("Removed %s" % f)
                    removed += 1
                except OSError as exc:
                    err_print("could not remove %s: %s" % (f, exc))

    config_file = project_dir / "polyglot.toml"
    if config_file.exists() and toml is not None:
        try:
            config = toml.load(config_file)
            for bin_cfg in config.get("bin", []):
                name = bin_cfg.get("name")
                if name:
                    continue  # executables are left alone by default
        except Exception:
            pass

    cache = BuildCache(project_dir)
    removed += cache.clear()
    for f in project_dir.glob(".polyglot-cache/*.tmp"):
        try:
            f.unlink()
            removed += 1
        except OSError:
            pass

    if removed == 0:
        print("No build artifacts to clean")
    else:
        print("Cleaned %d artifacts" % removed)


def cmd_version(tc, args):
    print("polyglot %s" % VERSION)
    if tc.cc_path is None:
        print("backend: no C compiler found")
    else:
        print("backend: %s" % tc.describe())
    print("run polyglot doctor for details")


